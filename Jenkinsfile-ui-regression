pipeline {

    agent any

    tools {
        jdk 'jdk11'
        maven 'maven3'
    }

    parameters {

        choice(
            name: 'RUN_MODE',
            choices: ['local', 'remote'],
            description: 'Execution Mode'
        )

        choice(
            name: 'BROWSER',
            choices: ['chrome', 'firefox'],
            description: 'Browser'
        )

        booleanParam(
            name: 'HEADLESS',
            defaultValue: true,
            description: 'Run tests in headless mode'
        )

        string(
            name: 'GRID_URL_PARAM',
            defaultValue: '',
            description: 'Optional. Shared Grid URL (e.g. http://grid-host:4444). Leave empty to start a grid on this agent.'
        )

        booleanParam(
            name: 'USE_SHARED_GRID',
            defaultValue: false,
            description: 'If true: do NOT start/stop grid on this agent; use GRID_URL_PARAM (or global GRID_URL).'
        )

        string(
            name: 'UNSTABLE_THRESHOLD_PERCENT',
            defaultValue: '5',
            description: 'Mark build UNSTABLE when failed% >= this value.'
        )

        string(
            name: 'FAILURE_THRESHOLD_PERCENT',
            defaultValue: '20',
            description: 'Mark build FAILURE when failed% >= this value.'
        )

        string(
            name: 'FAILURE_THRESHOLD_COUNT',
            defaultValue: '5',
            description: 'Mark build FAILURE when failed count >= this value.'
        )
    }

    environment {
        MAVEN_OPTS = '-Dmaven.repo.local=$WORKSPACE/.m2'
        GRID_COMPOSE = 'infrastructure/docker/docker-compose.grid-only.yml'
        // Path is relative to the web-ui module when using -pl web-ui
        UI_SUITE = 'src/test/resources/testng-ui-regression.xml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare') {
            steps {
                script {
                    def paramUrl = (params.GRID_URL_PARAM ?: '').trim()
                    env.GRID_URL = paramUrl ?: env.GRID_URL ?: 'http://localhost:4444'
                }
            }
        }

        stage('Build (skip tests)') {
            steps {
                sh '''
                mvn -B clean install \
                -DskipTests \
                -Ddependency-check.skip=true
                '''
            }
        }

        stage('Start Selenium Grid') {
            when {
                expression { params.RUN_MODE == 'remote' && !params.USE_SHARED_GRID }
            }
            steps {
                sh """
                docker compose -f ${env.GRID_COMPOSE} down || true
                docker compose -f ${env.GRID_COMPOSE} up -d --scale chrome=3 --scale firefox=0
                """
            }
        }

        stage('Resolve Grid URL') {
            when {
                expression { params.RUN_MODE == 'remote' && !params.USE_SHARED_GRID }
            }
            steps {
                script {
                    env.GRID_URL = 'http://selenium-hub:4444'
                }
            }
        }

        stage('Wait for Grid') {
            when {
                expression { params.RUN_MODE == 'remote' }
            }
            steps {
                sh """
                    set +x
                    BASE=\${GRID_URL:-http://localhost:4444}
                    TMP=\$(mktemp)
                    trap "rm -f \$TMP" EXIT
                    for i in \$(seq 1 30); do
                        curl -s "\${BASE%/}/status" -o "\$TMP" 2>/dev/null || true
                        if grep -qE '"ready"[[:space:]]*:[[:space:]]*true' "\$TMP" 2>/dev/null; then
                            echo "\$BASE" > .grid_url_used
                            exit 0
                        fi
                        curl -s "http://localhost:4444/status" -o "\$TMP" 2>/dev/null || true
                        if grep -qE '"ready"[[:space:]]*:[[:space:]]*true' "\$TMP" 2>/dev/null; then
                            echo "http://localhost:4444" > .grid_url_used
                            exit 0
                        fi
                        sleep 2
                    done
                    exit 1
                """
                script {
                    if (fileExists('.grid_url_used')) {
                        env.GRID_URL = readFile('.grid_url_used').trim()
                    }
                }
            }
        }

        stage('Run UI Regression') {
            steps {
                script {
                    // In regression we allow failures to become UNSTABLE (not immediate FAILURE).
                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                        sh """
                        mvn -pl web-ui test -B \
                        -Dsurefire.suiteXmlFiles=${env.UI_SUITE} \
                        -Drun.mode=${params.RUN_MODE} \
                        -Dbrowser=${params.BROWSER} \
                        -Dheadless=${params.HEADLESS} \
                        -Dgrid.url=${env.GRID_URL}
                        """
                    }
                }
            }
        }

        stage('Publish Allure (UI Regression)') {
            steps {
                script {
                    catchError(buildResult: null, stageResult: 'FAILURE') {
                        if (fileExists('web-ui/target/allure-results')) {
                            allure([
                                commandline: 'Allure',
                                includeProperties: false,
                                jdk: '',
                                reportBuildPolicy: 'ALWAYS',
                                unstableThresholdPercent: Integer.parseInt(params.UNSTABLE_THRESHOLD_PERCENT),
                                failureThresholdPercent: Integer.parseInt(params.FAILURE_THRESHOLD_PERCENT),
                                failureThresholdCount: Integer.parseInt(params.FAILURE_THRESHOLD_COUNT),
                                results: [[path: 'web-ui/target/allure-results']]
                            ])
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '**/target/**', fingerprint: true
            script {
                if (params.RUN_MODE == 'remote' && !params.USE_SHARED_GRID) {
                    sh "docker compose -f ${env.GRID_COMPOSE} down || true"
                }
            }
        }
    }
}

