pipeline {

```
agent any

parameters {

    choice(
        name: 'ENV',
        choices: ['dev','qa','prod'],
        description: 'Environment'
    )

    choice(
        name: 'SUITE',
        choices: ['smoke','regression'],
        description: 'Test suite'
    )

    choice(
        name: 'BROWSER',
        choices: ['chrome','firefox'],
        description: 'Browser'
    )

    choice(
        name: 'RUN_MODE',
        choices: ['local','remote'],
        description: 'Execution mode'
    )
}

environment {

    JAVA_HOME="/opt/java/openjdk"
    PATH="${JAVA_HOME}/bin:${env.PATH}"

    MAVEN_OPTS="-Xmx256m -XX:MaxMetaspaceSize=128m"
    MAVEN_ARGS="-B -T 1C"

    PUSHGATEWAY_URL="http://pushgateway:9091"

}

stages {

    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Verify Environment') {
        steps {
            sh '''
            java -version
            mvn -version
            '''
        }
    }

    stage('Build UI Module') {
        steps {
            sh """
            mvn ${env.MAVEN_ARGS} clean install \
            -pl web-ui \
            -am \
            -DskipTests \
            -Ddependency-check.skip=true
            """
        }
    }

    stage('Run UI Tests') {
        steps {
            sh """
            mvn ${env.MAVEN_ARGS} -pl web-ui test \
            -Denv=${params.ENV} \
            -Dsuite=${params.SUITE} \
            -Dbrowser=${params.BROWSER} \
            -Drun.mode=${params.RUN_MODE}
            """
        }
    }

    stage('Generate Allure') {
        steps {
            sh "mvn -pl web-ui allure:report -B || true"
        }
    }

    stage('Publish Allure') {
        steps {
            allure([
                includeProperties:false,
                reportBuildPolicy:'ALWAYS',
                results:[[path:'web-ui/target/allure-results']]
            ])
        }
    }

    stage('Push Metrics') {
        steps {
            sh """
            MODULE=ui \
            ENV=${params.ENV} \
            SUITE=${params.SUITE} \
            BROWSER=${params.BROWSER} \
            PUSHGATEWAY_URL=${env.PUSHGATEWAY_URL} \
            bash scripts/push-test-metrics.sh
            """
        }
    }

}
```

