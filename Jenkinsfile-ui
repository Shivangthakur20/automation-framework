pipeline {

    agent any

    tools {
        jdk 'jdk11'
        maven 'maven3'
    }

    parameters {

        choice(
            name: 'ENV',
            choices: ['dev', 'qa', 'prod'],
            description: 'Target environment'
        )

        choice(
            name: 'RUN_MODE',
            choices: ['local', 'remote'],
            description: 'Execution Mode'
        )

        choice(
            name: 'BROWSER',
            choices: ['chrome', 'firefox'],
            description: 'Browser'
        )

        booleanParam(
            name: 'HEADLESS',
            defaultValue: true,
            description: 'Run tests in headless mode'
        )

        string(
            name: 'GRID_URL_PARAM',
            defaultValue: '',
            description: 'Optional shared grid URL'
        )

        booleanParam(
            name: 'USE_SHARED_GRID',
            defaultValue: false,
            description: 'Use already running grid'
        )
    }

    environment {

        MAVEN_OPTS = '-Dmaven.repo.local=$WORKSPACE/.m2'

        GRID_COMPOSE = 'infrastructure/docker/docker-compose.grid-only.yml'

        PUSHGATEWAY_URL = 'http://pushgateway:9091'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Scripts') {
            steps {
                sh '''
                echo "Preparing scripts..."
                chmod +x scripts/push-test-metrics.sh
                '''
            }
        }

        stage('Prepare Grid URL') {
            steps {
                script {
                    def paramUrl = (params.GRID_URL_PARAM ?: '').trim()
                    env.GRID_URL = paramUrl ?: env.GRID_URL ?: 'http://localhost:4444'
                }
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                echo "Java version:"
                java -version

                echo "Maven version:"
                mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                mvn -B clean install \
                -DskipTests \
                -Ddependency-check.skip=true
                '''
            }
        }

        stage('Start Selenium Grid') {

            when {
                expression { params.RUN_MODE == 'remote' && !params.USE_SHARED_GRID }
            }

            steps {

                sh """
                echo "Stopping previous grid"
                docker compose -f ${env.GRID_COMPOSE} down || true
                """

                sh """
                echo "Starting Selenium Grid..."
                docker compose -f ${env.GRID_COMPOSE} up -d \
                --scale chrome=3 \
                --scale firefox=0
                """
            }
        }

        stage('Resolve Grid URL') {

            when {
                expression { params.RUN_MODE == 'remote' && !params.USE_SHARED_GRID }
            }

            steps {
                script {
                    env.GRID_URL = 'http://selenium-hub:4444'
                    echo "Using internal docker grid URL ${env.GRID_URL}"
                }
            }
        }

        stage('Wait for Grid') {

            when {
                expression { params.RUN_MODE == 'remote' }
            }

            steps {

                sh """
                BASE=\${GRID_URL:-http://localhost:4444}
                TMP=\$(mktemp)

                echo "Waiting for Selenium Grid..."

                for i in \$(seq 1 30); do

                    curl -s "\$BASE/status" -o "\$TMP" || true

                    if grep -q '"ready":true' "\$TMP"; then
                        echo "Grid ready"
                        exit 0
                    fi

                    echo "Grid not ready (\$i/30)..."
                    sleep 2
                done

                echo "Grid startup failed"
                exit 1
                """
            }
        }

        stage('Run UI Tests') {

            steps {

                script {

                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {

                        sh """
                        mvn -pl web-ui test -B \
                        -Denv=${params.ENV} \
                        -Drun.mode=${params.RUN_MODE} \
                        -Dbrowser=${params.BROWSER} \
                        -Dheadless=${params.HEADLESS} \
                        -Dgrid.url=${env.GRID_URL}
                        """
                    }
                }
            }
        }

        stage('Collect Test Metrics') {

            steps {

                script {

                    def summary = sh(
                        script: "grep -h 'Tests run:' web-ui/target/surefire-reports/*.txt || true",
                        returnStdout: true
                    ).trim()

                    echo "Surefire Summary: ${summary}"

                    def matcher = summary =~ /Tests run: (\\d+), Failures: (\\d+), Errors: (\\d+), Skipped: (\\d+)/

                    if (matcher) {

                        env.TEST_TOTAL = matcher[0][1]
                        env.TEST_FAIL = matcher[0][2]
                        env.TEST_ERROR = matcher[0][3]
                        env.TEST_SKIP = matcher[0][4]

                        env.TEST_PASS = (
                            env.TEST_TOTAL.toInteger() -
                            env.TEST_FAIL.toInteger() -
                            env.TEST_ERROR.toInteger()
                        ).toString()

                    } else {

                        env.TEST_PASS = "0"
                        env.TEST_FAIL = "0"
                        env.TEST_SKIP = "0"
                    }

                    echo "Passed: ${env.TEST_PASS}"
                    echo "Failed: ${env.TEST_FAIL}"
                    echo "Skipped: ${env.TEST_SKIP}"
                }
            }
        }

        stage('Generate Allure Report') {

            steps {

                script {

                    if (fileExists('web-ui/target/allure-results')) {
                        sh 'mvn -pl web-ui allure:report -B || true'
                    }

                }
            }
        }

        stage('Publish Allure Report') {

            steps {

                script {

                    if (fileExists('web-ui/target/allure-results')) {

                        allure([
                            includeProperties: false,
                            reportBuildPolicy: 'ALWAYS',
                            results: [[path: 'web-ui/target/allure-results']]
                        ])
                    }
                }
            }
        }

        stage('Push Metrics') {

            steps {

                script {

                    sh """
                    TESTS_PASSED=${env.TEST_PASS} \
                    TESTS_FAILED=${env.TEST_FAIL} \
                    TESTS_SKIPPED=${env.TEST_SKIP} \
                    MODULE=ui \
                    ENV=${params.ENV} \
                    SUITE=regression \
                    BROWSER=${params.BROWSER} \
                    PUSHGATEWAY_URL=${env.PUSHGATEWAY_URL} \
                    bash scripts/push-test-metrics.sh
                    """
                }
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: '**/target/**', fingerprint: true

            script {

                if (params.RUN_MODE == 'remote' && !params.USE_SHARED_GRID) {

                    sh """
                    echo "Stopping Selenium Grid..."
                    docker compose -f ${env.GRID_COMPOSE} down || true
                    """
                }
            }
        }

        success {
            echo 'UI build successful'
        }

        failure {
            echo 'UI build failed'
        }
    }
}