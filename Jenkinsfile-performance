pipeline {

```
agent any

parameters {

    choice(
        name:'ENV',
        choices:['dev','qa','prod'],
        description:'Environment'
    )

}

environment {

    JAVA_HOME="/opt/java/openjdk"
    PATH="${JAVA_HOME}/bin:${env.PATH}"

    MAVEN_OPTS="-Xmx256m"
    MAVEN_ARGS="-B"

    PUSHGATEWAY_URL="http://pushgateway:9091"

}

stages {

    stage('Checkout'){
        steps{
            checkout scm
        }
    }

    stage('Run Performance Tests'){
        steps{
            sh """
            mvn ${env.MAVEN_ARGS} \
            -pl perf-gatling gatling:test \
            -Denv=${params.ENV}
            """
        }
    }

    stage('Push Metrics'){
        steps{
            sh """
            MODULE=performance \
            ENV=${params.ENV} \
            SUITE=load \
            BROWSER=na \
            PUSHGATEWAY_URL=${env.PUSHGATEWAY_URL} \
            bash scripts/push-test-metrics.sh
            """
        }
    }

}
```

}
