pipeline {

    agent any

    tools {
        jdk 'jdk11'
        maven 'maven3'
    }

    parameters {

        choice(
            name: 'ENV',
            choices: ['dev','qa','prod'],
            description: 'Target environment'
        )

        choice(
            name: 'SCOPE',
            choices: ['smoke','regression'],
            description: 'Test suite scope'
        )
    }

    environment {

        MAVEN_OPTS = '-Dmaven.repo.local=$WORKSPACE/.m2'
        PUSHGATEWAY_URL = 'http://pushgateway:9091'

    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Scripts') {
            steps {
                sh '''
                chmod +x scripts/push-test-metrics.sh
                '''
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                java -version
                mvn -version
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                mvn -B clean install \
                -DskipTests
                '''
            }
        }

        stage('Run API Tests') {

            steps {

                sh """
                mvn -pl api test -B \
                -Denv=${params.ENV} \
                -Dsuite=${params.SCOPE}
                """

            }
        }

        stage('Collect Metrics') {

            steps {

                script {

                    def summary = sh(
                        script: "grep -h 'Tests run:' api/target/surefire-reports/*.txt || true",
                        returnStdout: true
                    ).trim()

                    def matcher = summary =~ /Tests run: (\\d+), Failures: (\\d+), Errors: (\\d+), Skipped: (\\d+)/

                    if (matcher) {

                        env.TOTAL = matcher[0][1]
                        env.FAIL = matcher[0][2]
                        env.ERROR = matcher[0][3]
                        env.SKIP = matcher[0][4]

                        env.PASS = (
                            env.TOTAL.toInteger() -
                            env.FAIL.toInteger() -
                            env.ERROR.toInteger()
                        ).toString()

                    } else {

                        env.PASS="0"
                        env.FAIL="0"
                        env.SKIP="0"

                    }

                }

            }

        }

        stage('Generate Allure') {

            steps {

                sh 'mvn -pl api allure:report -B || true'

            }

        }

        stage('Publish Allure') {

            steps {

                allure([
                    includeProperties:false,
                    reportBuildPolicy:'ALWAYS',
                    results:[[path:'api/target/allure-results']]
                ])

            }

        }

        stage('Push Metrics') {

            steps {

                sh """
                TESTS_PASSED=${env.PASS} \
                TESTS_FAILED=${env.FAIL} \
                TESTS_SKIPPED=${env.SKIP} \
                MODULE=api \
                ENV=${params.ENV} \
                SUITE=${params.SCOPE} \
                PUSHGATEWAY_URL=${env.PUSHGATEWAY_URL} \
                bash scripts/push-test-metrics.sh
                """

            }

        }

    }

}