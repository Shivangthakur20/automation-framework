pipeline {

    agent any

    tools {
        jdk 'jdk11'
        maven 'maven3'
        allure 'Allure'
    }

    parameters {

        choice(
            name: 'ENV',
            choices: ['dev','qa','prod'],
            description: 'Target environment'
        )

        choice(
            name: 'SCOPE',
            choices: ['smoke','regression'],
            description: 'API suite'
        )

    }

    environment {

        MAVEN_OPTS = "-Xmx256m -XX:MaxMetaspaceSize=128m"
        MAVEN_ARGS = "-B -T 1C"

        PUSHGATEWAY_URL = "http://pushgateway:9091"

    }

    stages {

        stage('Checkout') {

            steps {
                checkout scm
            }

        }

        stage('Prepare') {

            steps {

                sh '''
                echo "Preparing scripts"
                chmod +x scripts/push-test-metrics.sh || true
                '''

            }

        }

        stage('Verify Environment') {

            steps {

                sh '''
                echo "Java Version"
                java -version

                echo "Maven Version"
                mvn -version
                '''

            }

        }

        stage('Build API Module') {

            steps {

                sh """
                mvn ${env.MAVEN_ARGS} clean install \
                -pl api \
                -am \
                -DskipTests \
                -Ddependency-check.skip=true
                """

            }

        }

        stage('Run API Tests') {

            steps {

                sh """
                mvn ${env.MAVEN_ARGS} -pl api test \
                -Denv=${params.ENV} \
                -Dsuite=${params.SCOPE}
                """

            }

        }

        stage('Collect Metrics') {

            steps {

                script {

                    def summary = sh(
                        script: "grep -h 'Tests run:' api/target/surefire-reports/*.txt || true",
                        returnStdout: true
                    ).trim()

                    echo "Surefire Summary: ${summary}"

                    def matcher = summary =~ /Tests run: (\\d+), Failures: (\\d+), Errors: (\\d+), Skipped: (\\d+)/

                    if (matcher) {

                        env.TEST_TOTAL = matcher[0][1]
                        env.TEST_FAIL = matcher[0][2]
                        env.TEST_ERROR = matcher[0][3]
                        env.TEST_SKIP = matcher[0][4]

                        env.TEST_PASS = (
                            env.TEST_TOTAL.toInteger() -
                            env.TEST_FAIL.toInteger() -
                            env.TEST_ERROR.toInteger()
                        ).toString()

                    } else {

                        env.TEST_PASS = "0"
                        env.TEST_FAIL = "0"
                        env.TEST_SKIP = "0"

                    }

                    echo "Passed: ${env.TEST_PASS}"
                    echo "Failed: ${env.TEST_FAIL}"
                    echo "Skipped: ${env.TEST_SKIP}"

                }

            }

        }

        stage('Generate Allure Report') {

            steps {

                script {

                    if (fileExists('api/target/allure-results')) {

                        sh "mvn -pl api allure:report -B || true"

                    }

                }

            }

        }

        stage('Publish Allure Report') {

            steps {

                script {

                    if (fileExists('api/target/allure-results')) {

                        allure([
                            includeProperties: false,
                            reportBuildPolicy: 'ALWAYS',
                            results: [[path: 'api/target/allure-results']]
                        ])

                    }

                }

            }

        }

        stage('Push Metrics') {

            steps {

                sh """
                TESTS_PASSED=${env.TEST_PASS} \
                TESTS_FAILED=${env.TEST_FAIL} \
                TESTS_SKIPPED=${env.TEST_SKIP} \
                MODULE=api \
                ENV=${params.ENV} \
                SUITE=${params.SCOPE} \
                BROWSER=na \
                PUSHGATEWAY_URL=${env.PUSHGATEWAY_URL} \
                bash scripts/push-test-metrics.sh
                """

            }

        }

    }

    post {

        always {

            archiveArtifacts artifacts: '**/target/**', fingerprint: true

        }

        success {

            echo 'API build successful'

        }

        failure {

            echo 'API build failed'

        }

    }

}